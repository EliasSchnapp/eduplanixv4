# EDUPLANIX Production Environment Variables
# Kopiere diese Datei zu .env und fülle die Werte aus

# Umgebung
NODE_ENV=production

# Server Port (normalerweise 3000, bei All-Inkl eventuell anders)
PORT=3000

# PostgreSQL Datenbank URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://DEIN_USERNAME:DEIN_PASSWORT@localhost:5432/eduplanix

# Session Secret (generiere einen sicheren, zufälligen String)
# Nutze einen Generator wie: openssl rand -base64 32
SESSION_SECRET=dein-sehr-sicherer-session-schluessel-hier

# Optional: Weitere Konfiguration
# HTTPS=true
# DOMAIN=deine-domain.de